{
  "name": "SHUD",
  "version": "2.0.8",
  "private": true,
  "main": "src/main/main.js",
  "type": "module",
  "description": "SHUD app",
  "author": "fyflo",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start": "electron .",
    "dev": "electron .",
    "check:huds": "node ./scripts/check-huds.mjs",
    "rebuild:native": "electron-rebuild -f -w @josephuspaye/list-open-windows",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "active-win": "^8.2.1",
    "cors": "^2.8.5",
    "csgogsi": "^3.0.5",
    "csgogsi-generator": "^1.2.0",
    "electron-updater": "^6.6.2",
    "express": "^4.21.2",
    "extract-zip": "^2.0.1",
    "i18next": "^25.6.0",
    "ip": "^2.0.1",
    "ip-address": "^10.0.1",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "nedb-promises": "^6.2.1",
    "node-global-key-listener": "^0.3.0",
    "node-tesseract-ocr": "^2.2.1",
    "obs-websocket-js": "^5.0.6",
    "png-to-ico": "^3.0.1",
    "public-ip": "^8.0.0",
    "pug": "^3.0.3",
    "puppeteer": "^24.26.1",
    "react-color": "^2.19.3",
    "react-color-palette": "^7.3.1",
    "react-i18next": "^16.2.0",
    "sharp": "^0.34.4",
    "socket.io": "^4.7.2",
    "tesseract.js": "^6.0.1"
  },
  "optionalDependencies": {
    "@josephuspaye/list-open-windows": "^0.1.2",
    "exceljs": "^4.3.0",
    "telnet-stream": "*"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "electron": "^39.2.7",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.fyflo.shudmanager",
    "productName": "SHUD",
    "icon": "src/files/img/favicon.ico",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "SHUD",
      "installerIcon": "src/files/img/favicon.ico",
      "uninstallerIcon": "src/files/img/favicon.ico",
      "language": "1033,1049,2052,1046"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
